{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Still2Solid",
  "version": "0.8.2",
  "identifier": "app.still2solid.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../apps/desktop/ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Still2Solid",
        "width": 1180,
        "height": 820,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/python/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
